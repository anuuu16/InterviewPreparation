{
  "name": "interview-preparation",
  "private": true,
  "scripts": {
    "setup": "npm --prefix app/web install && npm --prefix app/web run build",
    "kill": "node app/kill.js",
    "prestart": "node app/kill.js --quiet",
    "start": "node app/server.js",
    "dev": "npm --prefix app/web run dev",
    "build": "node app/build.js",
    "validate": "node app/validate.js",
    "import": "node app/import.js",
    "tts:setup": "sh tools/piper/setup.sh",
    "feedback": "node app/feedback.js",
    "problems:test": "node app/problems-test.js",
    "resources:check": "node app/resources-check.js",
    "build:static": "npm --prefix app/web run build:static && node app/export-static.js",
    "preview:static": "npx wrangler pages dev app/web/dist-static"
  }
}
